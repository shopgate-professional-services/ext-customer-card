{
  "version": "1.0.0",
  "id": "@shopgate-project/customer-card",
  "components": [
    {
      "id": "subscribersCustomerCard",
      "path": "frontend/pages/CustomerCard/subscriptions.js",
      "type": "subscribers"
    },
    {
      "id": "NavMenuCustomerCard",
      "path": "frontend/portals/NavMenuCustomerCard",
      "target": "nav-menu.cart.before",
      "type": "portals"
    },
    {
      "id": "MoreMenuCustomerCard",
      "path": "frontend/portals/MoreMenuCustomerCard",
      "target": "nav-menu.quick-links.items.before",
      "type": "portals"
    },
    {
      "id": "TabBarCustomerCard",
      "path": "frontend/portals/TabBarCustomerCard/index.jsx",
      "target": "tab-bar.cart.after",
      "type": "portals"
    },
    {
      "id": "CustomerCard",
      "path": "frontend/pages/CustomerCard/index.jsx",
      "target": "app.routes",
      "type": "portals"
    },
    {
      "type": "translations",
      "path": "frontend/locale/de-DE.json",
      "id": "locale/de-DE"
    },
    {
      "type": "translations",
      "path": "frontend/locale/en-US.json",
      "id": "locale/en-US"
    },
    {
      "type": "translations",
      "path": "frontend/locale/es-ES.json",
      "id": "locale/es-ES"
    },
    {
      "type": "translations",
      "path": "frontend/locale/fr-FR.json",
      "id": "locale/fr-FR"
    },
    {
      "type": "translations",
      "path": "frontend/locale/it-IT.json",
      "id": "locale/it-IT"
    }
  ],
  "configuration": {
    "iconSvgContent": {
      "type": "admin",
      "destination": "frontend",
      "default": "<g transform='translate(2, 5)'><path d='M20 3.36719V2.3125C20 1.10438 19.0206 0.125 17.8125 0.125H2.1875C0.979375 0.125 0 1.10438 0 2.3125V3.36719C0 3.47504 0.0874609 3.5625 0.195312 3.5625H19.8047C19.9125 3.5625 20 3.47504 20 3.36719Z'></path><path d='M0 5.00781V11.6875C0 12.8956 0.979375 13.875 2.1875 13.875H17.8125C19.0206 13.875 20 12.8956 20 11.6875V5.00781C20 4.89996 19.9125 4.8125 19.8047 4.8125H0.195312C0.0874609 4.8125 0 4.89996 0 5.00781ZM5 10.125C5 10.4702 4.72016 10.75 4.375 10.75H3.75C3.40484 10.75 3.125 10.4702 3.125 10.125V9.5C3.125 9.15484 3.40484 8.875 3.75 8.875H4.375C4.72016 8.875 5 9.15484 5 9.5V10.125Z'></path></g>",
      "params": {
        "type": "string",
        "label": "Raw SVG markup for the tab bar icon."
      }
    },
    "textMenuEntry": {
      "type": "admin",
      "destination": "frontend",
      "default": "Customer Card",
      "params": {
        "type": "string",
        "label": "Text for the customer card menu entry."
      }
    },
    "textHeadline": {
      "type": "admin",
      "destination": "frontend",
      "default": "Your customer card",
      "params": {
        "type": "string",
        "label": "Headline text for the customer card."
      }
    },
    "textAboveCode": {
      "type": "admin",
      "destination": "frontend",
      "default": "<p>{firstName} {lastName}</p>",
      "params": {
        "type": "string",
        "label": "Informational text displayed above the code."
      }
    },
    "textBelowCode": {
      "type": "admin",
      "destination": "frontend",
      "default": "<p>Some information such as user's e-mail address: <strong>{mail}</strong></p>",
      "params": {
        "type": "string",
        "label": "Informational text displayed below the code."
      }
    },
    "cardStyle": {
      "type": "admin",
      "destination": "frontend",
      "default": "gradient",
      "params": {
        "type": "select",
        "label": "Card style",
        "description": "How the card uses the primary color of the app theme.",
        "required": true,
        "options": {
          "multiple": false,
          "options": [
            {
              "label": "Gradient of the primary color",
              "value": "gradient"
            },
            {
              "label": "Primary color",
              "value": "solid"
            },
            {
              "label": "Primary color as a soft tint",
              "value": "tinted"
            }
          ]
        }
      }
    },
    "showShine": {
      "type": "admin",
      "destination": "frontend",
      "default": false,
      "params": {
        "type": "checkbox",
        "label": "Shine effect",
        "description": "Lets a light shine sweep once over the card after it appeared."
      }
    },
    "overrideColorCodeBackground": {
      "type": "admin",
      "destination": "frontend",
      "default": null,
      "params": {
        "type": "string",
        "label": "Override: code background color",
        "description": "Background of the QR code or barcode area. Leave empty for white."
      }
    },
    "overrideColorCardBackground": {
      "type": "admin",
      "destination": "frontend",
      "default": null,
      "params": {
        "type": "string",
        "label": "Override: card background color",
        "description": "Replaces the card style. The text color is derived from it. Leave empty to use the primary color of the app theme."
      }
    },
    "overrideColorText": {
      "type": "admin",
      "destination": "frontend",
      "default": null,
      "params": {
        "type": "string",
        "label": "Override: card text color",
        "description": "Leave empty to use the matching text color of the app theme."
      }
    },
    "overrideColorCode": {
      "type": "admin",
      "destination": "frontend",
      "default": null,
      "params": {
        "type": "string",
        "label": "Override: code color",
        "description": "Color of the QR code or barcode. Leave empty for black."
      }
    },
    "overrideLogoUrl": {
      "type": "admin",
      "destination": "frontend",
      "default": null,
      "params": {
        "type": "string",
        "label": "Override: logo URL",
        "description": "Leave empty to use the shop logo of the app. Set it, for example, to a white logo that is easier to read on the card."
      }
    },
    "useQrCodeMode": {
      "type": "admin",
      "destination": "frontend",
      "default": true,
      "params": {
        "type": "checkbox",
        "label": "Enable or disable QR code mode for the customer card."
      }
    },
    "barcodeFormat": {
      "type": "admin",
      "destination": "frontend",
      "default": "CODE128",
      "params": {
        "type": "text",
        "label": "Barcode format (e.g., 'CODE128' or 'MSI')."
      }
    },
    "showTabBarEntry": {
      "type": "admin",
      "destination": "frontend",
      "default": true,
      "params": {
        "type": "checkbox",
        "label": "Show or hide the customer card entry in the tab bar."
      }
    }
  }
}
